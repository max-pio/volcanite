float computeWeight(float depthCenter, float depthP, float phiDepth, float luminanceIllumCenter,
                    float luminanceIllumP, float phiIllum) {

    float weightZ = (phiDepth == 0) ? 0.f : 1.f;
    weightZ = (phiDepth == 0) ? 0.f : abs(depthCenter - depthP) / phiDepth;

    //const float weightLillum = 1.f;
    const float weightLillum = abs(luminanceIllumCenter - luminanceIllumP) / phiIllum;

    const float weightIllum = exp(0.0 - max(weightLillum, 0.0) - max(weightZ, 0.0));
    return weightIllum;
}

float computeVarianceCenter(ivec2 ipos, const ivec2 viewport_size) {
    // not yet supported
    return 1.f;
    float sum_m1 = 0.f;
    float sum_m2 = 0.f;
    float sumW = 0.f;
    const float kernel[2][2] = {
    { 1.0 / 4.0, 1.0 / 8.0 },
    { 1.0 / 8.0, 1.0 / 16.0 },
    };

    // collect first and second momentum and blur with gaussian kernel
    const int radius = 1; // 3x3 kernel
    for (int yy = -radius; yy <= radius; yy++) {
        for (int xx = -radius; xx <= radius; xx++) {
            const vec2 block_pixel = ipos + vec2(xx, yy);
            const float k = kernel[abs(xx)][abs(yy)];

            if (any(lessThan(block_pixel, ivec2(0))) || any(greaterThanEqual(block_pixel, viewport_size)))
                continue;

            float lum = luminance(imageLoad(denoisingBuffer[pc.denoising_iteration % 2], ivec2(block_pixel)).rgb);
            sum_m1 += lum * k;
            sum_m2 += (lum * lum) * k;
            sumW += k;
        }
    }
    sum_m1 /= max(sumW, 1e-8f);
    sum_m2 /= max(sumW, 1e-8f);
    return sum_m2 - (sum_m1 * sum_m1);
}

// inplace alpha blending of pixel_rgba with the background color that is visible for the primary ray through block_pixel
vec4 blendWithBackground(vec4 pixel_rgba, ivec2 block_pixel) {
    vec2 subpixel_offset = randomVec3(block_pixel, g_camera_still_frames).xy;
    vec2 fragCoord = (vec2(block_pixel) + subpixel_offset) / vec2(imageSize(inpaintedOutColor));
    vec3 viewRayDirection = normalize((g_pixel_to_ray_direction_world_space * vec3(block_pixel + subpixel_offset, 1.0f)).xyz);
    pixel_rgba = pixel_rgba.a * pixel_rgba + (1.f - pixel_rgba.a) * get_background_color(fragCoord, viewRayDirection);
    return pixel_rgba;
}

// TODO: split into separate shaders as either bilateral or À-trous denoising is used (or remove bilateral alltogether)
void main() {
    // obtain pixel and fragment coordinates
    const ivec2 viewport_size = imageSize(inpaintedOutColor);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // only one thread per pixel block
    if (isHelperLane(pixel, viewport_size))
        return;

    if (g_bilateral_enable && pc.denoising_iteration != LAST_DENOISING_ITERATION)
        return;

    // read the HDR radiance + alpha that was accumulated for this pixel so far
    // needs normalization based on sample count
    vec4 pixel_color = g_svgf_enable ? imageLoad(denoisingBuffer[pc.denoising_iteration % 2], pixel)
                                     : imageLoad(accumulationOut, pixel);

    // unpack the G-Buffer for the current output pixel
    float center_normalized_depth;
    vec3 center_normal;
    uint center_label_hash;
    const uvec2 g_buffer_packed = imageLoad(gBuffer, pixel).rg;
    // valid is false if the pixel did not receive a sample yet
    bool center_valid = unpackGBufferRG8(g_buffer_packed, center_label_hash, center_normal, center_normalized_depth);

    vec4 accum_rgba = vec4(0.f);
    ivec2 filter_pixel;
    float weight = 1.f;
    float weight_sum  = 0.f;

    // fade out the denoising over time
    float fade = 1.f;
    if (g_denoise_fade_enable) {
        fade = g_denoise_fade_sigma / sqrt(g_camera_still_frames / (g_subsampling * g_subsampling));
        fade = min(fade, 1.f);
    }

    if (fade < 0.01f) {
        uint sample_count = max(imageLoad(accuSampleCountOut, pixel).r, 1u);
        accum_rgba = imageLoad(accumulationOut, pixel) / float(sample_count);
        accum_rgba.r = 0.f;
    // BILATERAL FILTER ------------------------------------------------------------------------------------------------
    } else if (g_bilateral_enable) {
        uint sample_count = max(imageLoad(accuSampleCountOut, pixel).r, 1u);
        pixel_color /= float(sample_count);

        for (int dx = -g_denoise_filter_kernel_size; dx < g_denoise_filter_kernel_size; dx++) {
            for (int dy = -g_denoise_filter_kernel_size; dy < g_denoise_filter_kernel_size; dy++) {
                filter_pixel = pixel + ivec2(dx, dy);
                if (isHelperLane(filter_pixel, viewport_size))
                    continue;

                // unpack gBuffer
                float normalized_depth;
                vec3 normal;
                uint label_hash;
                if (!unpackGBufferRG8(imageLoad(gBuffer, filter_pixel).rg, label_hash, normal, normalized_depth))
                    continue;

                // weight the pixel colors by sample counts
                uint sample_count_block = max(imageLoad(accuSampleCountOut, filter_pixel).r, 1u);
                vec4 rgba_block = imageLoad(accumulationOut, filter_pixel) / float(sample_count_block);

                // if the center pixel did not receive a sample yet, it gets the average color of all neighboring pixels
                // that already received a sample
                if (center_valid) {
                    if (all(equal(normal, vec3(0.f))) || any(notEqual(center_normal, normal)))
                        continue;
                    if (abs(float(center_normalized_depth) - float(normalized_depth)) + 0.001f > g_difference_depth_denoising)
                        continue;

                    if (g_spatial_sigma > 0)
                        weight *= gaussian(length(vec2(dx, dy)), g_spatial_sigma);
                    if (g_depth_sigma > 0)
                        weight *= gaussian(luminance(pixel_color.rgb) - luminance(rgba_block.rgb), g_depth_sigma);
                }

                accum_rgba += rgba_block * weight;
                weight_sum += weight;
            }
        }
    // MULTI-PASS À-TROUS FILTER ---------------------------------------------------------------------------------------
    } else if (g_svgf_enable) {
        // svgf
        // for now only À-Trous filter w/o any variance estimation or temporal accumulation
        const int step_size = 1 << pc.denoising_iteration;
        const vec3 kernel_weights = { 1.f, 2.f / 3.f * fade, 1.f / 6.f * fade * fade};
        const float var = computeVarianceCenter(pixel, viewport_size);

        const float EPS = 0.01f;
        const float phi_Lillumination = g_illumination_sigma * sqrt(var) + EPS;
        //const float phi_Lillumination = 1.f; // unnused for now
        const float phi_depth = max(center_normalized_depth, 1e-8) * step_size;

        for (int dy = -g_denoise_filter_kernel_size; dy <= g_denoise_filter_kernel_size; dy++) {
            for (int dx = -g_denoise_filter_kernel_size; dx <= g_denoise_filter_kernel_size; dx++) {
                filter_pixel = pixel + ivec2(dx, dy) * step_size;

                if (isHelperLane(filter_pixel, viewport_size))
                    continue;

                float normalized_depth;
                vec3 normal;
                uint label_hash;
                // if the center pixel did not receive a sample, accumulate all filter pixels in later passes
                if ((pc.denoising_iteration == 0 || center_valid)
                    && !unpackGBufferRG8(imageLoad(gBuffer, filter_pixel).rg, label_hash, normal, normalized_depth))
                    continue;

                // normalize the pixel radiance by sample counts in the first À-trous iteration
                uint sample_count_block = pc.denoising_iteration == 0 ? max(imageLoad(accuSampleCountOut, filter_pixel).r, 1u) : 1u;
                vec4 rgba_block = imageLoad(denoisingBuffer[pc.denoising_iteration % 2], filter_pixel) / float(sample_count_block);

                // accumluated radiance from previous À-trous interations that did not receive a single sample is marked
                // with a negative alpha value. These are skipped.
                if (rgba_block.a < 0.f)
                    continue;

                if (center_valid) {
                    // quantized normals: either (+/-) 90 or (+/-) 180 degree angle
                    // => abs(cos) (= weightN) is either 0 or 1
                    if (any(notEqual(center_normal, normal)) || all(equal(normal, vec3(0.f))))
                        continue;
                    if (label_hash != center_label_hash)
                        continue;

                    const float kernel = kernel_weights[abs(dx)] * kernel_weights[abs(dy)];
                    const float w = computeWeight(center_normalized_depth, normalized_depth, phi_depth,
                    luminance(imageLoad(denoisingBuffer[pc.denoising_iteration % 2], pixel).xyz),
                    luminance(imageLoad(denoisingBuffer[pc.denoising_iteration % 2], filter_pixel).xyz), phi_Lillumination);

                    weight = w * kernel;
                }
                accum_rgba += rgba_block * weight;
                weight_sum += weight;
            }
        }
    // NO FILTER -------------------------------------------------------------------------------------------------------
    } else {
        uint sample_count = max(imageLoad(accuSampleCountOut, pixel).r, 1u);
        accum_rgba = pixel_color / float(sample_count);
        const float EPS = 0.01f;
        const float phi_Lillumination = g_illumination_sigma * sqrt(computeVarianceCenter(pixel, viewport_size)) + EPS;
        accum_rgba = vec4(vec3(phi_Lillumination), 1.f);
    }

    if (weight_sum > 0.f)
        accum_rgba.rgba /= weight_sum;

    // À-trous feedback to next denoising iteration kernel in HDR
    if (pc.denoising_iteration < LAST_DENOISING_ITERATION) {
        // mark pixels from a filter step that did not receive a single rendered sample with a negative alpha value
        if (weight_sum <= 0.f)
            accum_rgba.a = -1.f;

        // store color for next iteration
        imageStore(denoisingBuffer[(pc.denoising_iteration + 1u) % 2], pixel, accum_rgba);
    // final pixel output in LDR
    } else {
#if 0
        // debug non-denoised (left) vs. denoised (right) output
        if (pixel.x < viewport_size.x / 2) {
            uint sample_count_block = max(imageLoad(accuSampleCountOut, pixel).r, 1u);
            accum_rgba = imageLoad(accumulationOut, pixel) / float(sample_count_block);
        }
#endif

        // perform tonemapping and color space conversion
        if(g_tonemap_enable) {
            accum_rgba.rgb *= 2.4f; // increase exposure
            accum_rgba.rgb = tonemap_ACES(accum_rgba.rgb);
            accum_rgba.rgb = rgb2srgb(accum_rgba.rgb);
        }

        // output to display image
        imageStore(inpaintedOutColor, pixel, blendWithBackground(accum_rgba, pixel));
    }
}
