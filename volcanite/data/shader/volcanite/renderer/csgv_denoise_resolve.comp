#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_buffer_reference_uvec2 : require

layout (local_size_x = 8, local_size_y = 8) in;

#include "csgv_bindings.glsl"
#include "util.glsl"
#include "framebuffer.glsl"
#include "dummy_envmap.glsl"

#define max_denoising_iterations 2 // =svgf_passes-1 dependency with command buffer pipeline creation in PassCompSegVolRenderer

vec3 rgb2srgb(vec3 x) {
    return pow(x, vec3(2.2f));
}

float luminance(vec3 v) {
    return 0.2126 * v.x + 0.7152 * v.y + 0.0722 * v.z;
}

vec3 tonemap_ACES(vec3 x)
{
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), vec3(0.f), vec3(1.f));
}

float gaussian(float x, float sigma) {
    return exp(-0.5 * (x * x) / (sigma * sigma));
}

float computeWeight(float depthCenter, float depthP, float phiDepth, float luminanceIllumCenter,
float luminanceIllumP, float phiIllum) {

    float weightZ = (phiDepth == 0) ? 0.f : 1.f;
    weightZ = (phiDepth == 0) ? 0.f : abs(depthCenter - depthP) / phiDepth;

    const float weightLillum = 1.f;
//    const float weightLillum = abs(luminanceIllumCenter - luminanceIllumP) / phiIllum;

    const float weightIllum = exp(0.0 - max(weightLillum, 0.0) - max(weightZ, 0.0));

    return weightIllum;
}

float computeVarianceCenter(ivec2 ipos, const ivec2 viewport_size) {
    // not yet supported
    return 0.f;
    float sum = 0.f;
    float sumW = 0.f;
    const float kernel[2][2] = {
    { 1.0 / 4.0, 1.0 / 8.0 },
    { 1.0 / 8.0, 1.0 / 16.0 },
    };

    // collect first and second momentum and blur with gaussian kernel
    const int radius = 1; // 3x3 kernel
    for (int yy = -radius; yy <= radius; yy++) {
        for (int xx = -radius; xx <= radius; xx++) {
            const vec2 block_pixel = ipos + vec2(xx, yy);
            const float k = kernel[abs(xx)][abs(yy)];

            if (any(lessThan(block_pixel, ivec2(0))) || any(greaterThanEqual(block_pixel, viewport_size)))
            continue;
            vec4 col = imageLoad(denoisingBuffer[pc.denoising_iteration % 2], ivec2(block_pixel));
            float lum = luminance(col.rgb);
            sum += (lum + lum * lum) * k;
            sumW += sum;
        }
    }
    sum /= max(sumW, 1e-8f);
    float varianz = sum + sum * sum;
    return varianz;
}

// inplace alpha blending of pixel_rgba with the background color that is visible for the primary ray through block_pixel
vec4 blendWithBackground(vec4 pixel_rgba, ivec2 block_pixel) {
    vec2 subpixel_offset = randomVec3(block_pixel, g_camera_still_frames).xy;
    vec2 fragCoord = (vec2(block_pixel) + subpixel_offset) / vec2(imageSize(inpaintedOutColor));
    vec3 viewRayDirection = normalize((g_pixel_to_ray_direction_world_space * vec3(block_pixel + subpixel_offset, 1.0f)).xyz);
    pixel_rgba = pixel_rgba.a * pixel_rgba + (1.f - pixel_rgba.a) * get_background_color(fragCoord, viewRayDirection);
    return pixel_rgba;
}

void main() {
    // obtain pixel and fragment coordinates
    const ivec2 viewport_size = imageSize(inpaintedOutColor);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // We output a low resolution image were multiple pixel are merged into one if the image does not have all pixels set yet
    // The current_block_size is the dimension of the pixel block in which one sample is guaranteed to be rendererd already.
    // After a certain number of frames, this will constantly be 1 because each pixel got at least one sample.
    const int current_block_size = clamp(g_subsampling / (1 << int(log2(sqrt(g_camera_still_frames + 1)))), 1, g_subsampling);

    // only one thread per pixel block
    if(isHelperLane(pixel, viewport_size))
    return;

    // read the HDR radiance that was accumulated for this pixel so far
    uint sample_count = pc.denoising_iteration == 0 ? max(imageLoad(accuSampleCountOut, pixel).r, 1u) : 1u;
    vec4 pixel_color = g_svgf_enable ? imageLoad(denoisingBuffer[pc.denoising_iteration % 2], pixel) : imageLoad(accumulationOut, pixel);
    pixel_color /= float(sample_count);

    // unpack the G-Buffer for the pixel
    float normalized_depth;
    vec3 normal;
    uint label_hash;
    uvec2 g_buffer_packed = imageLoad(gBuffer, pixel).rg;
    bool valid = unpackGBufferRG8(g_buffer_packed, label_hash, normal, normalized_depth);

    vec4 accum_rgba = vec4(0.f);
    if ((g_bilateral_enable || g_svgf_enable) && valid) {
        ivec2 block_pixel;
        float weight = 1.f;
        float normalization  = 0.f;
        if (g_bilateral_enable) {
            // bilateral denoising
            // based on the difference between normal and depth values
            for (int xx = -g_denoise_filter_kernel_size; xx < g_denoise_filter_kernel_size; xx++) {
                for (int yy = -g_denoise_filter_kernel_size; yy < g_denoise_filter_kernel_size; yy++) {
                    block_pixel = pixel + ivec2(xx, yy);
                    if (isHelperLane(block_pixel, viewport_size))
                        continue;
                    // unpack gBuffer
                    float normalized_depth_temp;
                    vec3 normal_temp;
                    uint label_hash_temp;
                    uvec2 g_buffer_packed_temp = imageLoad(gBuffer, block_pixel).rg;
                    if (!unpackGBufferRG8(g_buffer_packed_temp, label_hash_temp, normal_temp, normalized_depth_temp)) continue;

                    // weight the pixel colors by sample counts
                    uint sample_count_block = max(imageLoad(accuSampleCountOut, block_pixel).r, 1u);
                    vec4 rgba_block = imageLoad(accumulationOut, block_pixel) / float(sample_count_block);

                    if (any(notEqual(normal, normal_temp))) continue;
                    if (abs(float(normalized_depth) - float(normalized_depth_temp)) + 0.001f > g_difference_depth_denoising) continue;

                    float spatial_gaussian = 1.f;
                    if (g_spatial_sigma > 0)
                        spatial_gaussian = gaussian(length(vec2(xx, yy)), g_spatial_sigma);

                    float depth_gaussian = 1.f;
                    if (g_depth_sigma > 0)
                        depth_gaussian.r = gaussian((pixel_color.r + pixel_color.g + pixel_color.b) - (rgba_block.r + rgba_block.g + rgba_block.b), g_depth_sigma);
//                            depth_gaussian.r = gaussian(length(pixel_color.rgb - rgb_samples.rgb), g_depth_sigma);

                    float weight = spatial_gaussian * depth_gaussian;

                    accum_rgba += rgba_block * weight;
                    normalization += weight;
                }
            }
        } else if (g_svgf_enable) {
            // svgf
            // for now only À-Trous filter w/o any variance estimation or temporal accumulation
            const float EPS = 0.01f;
            const vec3 kernel_weights = { 1.f, 2.f / 3.f, 1.f / 6.f };
//            const float var = computeVarianceCenter(pixel, viewport_size);

            const int step_size = int(pow(2, int(pc.denoising_iteration)));

//            const float phi_Lillumination = g_illumination_sigma * sqrt(var) + EPS;
            const float phi_Lillumination = 1.f; // unnused for now
            const float phi_depth = max(normalized_depth, 1e-8) * step_size;

            for (int yy = -g_denoise_filter_kernel_size; yy <= g_denoise_filter_kernel_size; yy++) {
                for (int xx = -g_denoise_filter_kernel_size; xx <= g_denoise_filter_kernel_size; xx++) {
                    block_pixel = pixel + ivec2(xx, yy) * step_size;

                    if (isHelperLane(block_pixel, viewport_size))
                        continue;

                    float normalized_depth_temp;
                    vec3 normal_temp;
                    uint label_hash_temp;
                    uvec2 g_buffer_packed_temp = imageLoad(gBuffer, block_pixel).rg;
                    if (!unpackGBufferRG8(g_buffer_packed_temp, label_hash_temp, normal_temp, normalized_depth_temp)) continue;

                    // weight the pixel colors by sample counts
                    uint sample_count_block = pc.denoising_iteration == 0 ? max(imageLoad(accuSampleCountOut, block_pixel).r, 1u) : 1u;
                    vec4 rgba_block = imageLoad(denoisingBuffer[pc.denoising_iteration % 2], block_pixel) / float(sample_count_block);

                    // we have quantized normals, so we have either (+/-) 90 or (+/-) 180 degree angles
                    // -> abs(cos) therefore weightN is either 0 or 1
                    if (any(notEqual(normal, normal_temp)) || all(equal(normal_temp, vec3(0.f)))) continue;
                    if (label_hash_temp != label_hash) continue;

                    const float kernel = kernel_weights[abs(xx)] * kernel_weights[abs(yy)];
                    const float w = computeWeight(normalized_depth, normalized_depth_temp, phi_depth,
                    luminance(imageLoad(denoisingBuffer[pc.denoising_iteration % 2], pixel).xyz),
                    luminance(imageLoad(denoisingBuffer[pc.denoising_iteration % 2], block_pixel).xyz), phi_Lillumination);

                    weight = w * kernel;
                    accum_rgba += rgba_block * weight;
                    normalization += weight;
                }
            }
        }

        if (normalization  > 0.f)
            accum_rgba.rgba /= normalization;

        if (pixel.x + pixel.y < int((viewport_size.x + viewport_size.y) / 2.5) && pc.denoising_iteration == max_denoising_iterations) {
            uint sample_count_block = max(imageLoad(accuSampleCountOut, pixel).r, 1u);
            accum_rgba = imageLoad(accumulationOut, pixel) / float(sample_count_block);
        }
    }

    // perform tonemapping and color space conversion
    if(g_tonemap_enable && pc.denoising_iteration == max_denoising_iterations) {
        accum_rgba.rgb *= 2.4f; // increase exposure
        accum_rgba.rgb = tonemap_ACES(accum_rgba.rgb);
        accum_rgba.rgb = rgb2srgb(accum_rgba.rgb);
    }

    // output to display image
    imageStore(inpaintedOutColor, pixel, blendWithBackground(accum_rgba, pixel));
    // store color for next iteration
    imageStore(denoisingBuffer[(pc.denoising_iteration + 1u) % 2], pixel, accum_rgba);
}
